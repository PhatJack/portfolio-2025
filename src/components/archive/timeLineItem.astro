---
interface Props {
  timeLineTitle: string;
  timePeriod: string;
  listDocs: { title: string; content: string }[];
  image?: string;
  altText?: string;
  imageLink?: string;
  timelineDelay?: string;
}

const { timePeriod, listDocs, image, altText, timeLineTitle, imageLink, timelineDelay } =
  Astro.props as Props;
---

<article
  class="timeline-item group relative pl-8 sm:pl-12"
  style={`--timeline-delay: ${timelineDelay ?? "0ms"};`}
>
  <span class="timeline-rail" aria-hidden="true"></span>
  <span class="timeline-node" aria-hidden="true"></span>

  <div
    class="timeline-card overflow-hidden rounded-[1.75rem] border border-theme-500"
  >
    <header
      class="flex flex-wrap items-center justify-between gap-3 border-b border-theme-100 px-5 py-4 dark:border-theme-800"
    >
      <h3 class="mt-1 text-lg font-semibold text-dark dark:text-white sm:text-xl">
        {timeLineTitle}
      </h3>

      <span
        class="inline-flex items-center rounded-full border border-theme-200 bg-theme-100 px-3 py-1 text-sm font-semibold text-theme-700 transition-colors duration-300 group-hover:bg-theme-200 dark:border-theme-700 dark:bg-theme-800 dark:text-theme-100"
      >
        {timePeriod}
      </span>
    </header>

    <div class="grid gap-5 px-5 py-5 md:grid-cols-[minmax(0,1fr)_auto] md:items-start">
      <dl class="grid gap-3">
        {
          listDocs.map((doc) => (
            <div class="rounded-2xl border border-theme-100 bg-theme-100 px-4 py-3 transition-transform duration-300 group-hover:translate-x-1 dark:border-theme-800 dark:bg-theme-800">
              <dt class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-theme-600 dark:text-theme-300">
                {doc.title}
              </dt>
              <dd class="mt-1 text-sm leading-relaxed text-dark/80 dark:text-white/80">
                {doc.content}
              </dd>
            </div>
          ))
        }
      </dl>

      {
        image && (
          <a
            href={imageLink}
            target="_blank"
            rel="noreferrer"
            class="mx-auto inline-flex size-24 shrink-0 overflow-hidden rounded-full border-4 border-theme-100 transition-transform duration-300 group-hover:scale-105 dark:border-theme-700 dark:shadow-theme-800 sm:size-28 md:mx-0"
            aria-label={timeLineTitle}
          >
            <img
              src={image}
              alt={altText ?? timeLineTitle}
              class="size-full object-cover object-center"
              loading="lazy"
              decoding="async"
            />
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .timeline-item {
    animation: timelineFadeUp 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--timeline-delay, 0ms);
  }

  .timeline-rail {
    position: absolute;
    left: 1rem;
    top: 0.5rem;
    bottom: 0;
    width: 2px;
    border-radius: 9999px;
    background: linear-gradient(
      180deg,
      var(--theme-primary-100),
      var(--theme-primary-500),
      var(--theme-primary-200)
    );
  }

  .dark .timeline-rail {
    background: linear-gradient(
      180deg,
      var(--theme-primary-900),
      var(--theme-primary-400),
      var(--theme-primary-700)
    );
  }

  .timeline-node {
    position: absolute;
    left: calc(1rem - 0.3rem);
    top: 0.5rem;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 9999px;
    background: linear-gradient(135deg, var(--theme-primary-400), var(--theme-primary-700));
    box-shadow: 0 0 0 8px var(--theme-primary-100);
  }

  .dark .timeline-node {
    box-shadow: 0 0 0 8px var(--theme-primary-800);
  }
  @keyframes timelineFadeUp {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
