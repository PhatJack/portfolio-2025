---
import Row from "@/components/about/row.astro";
import Layout from "@/layouts/Layout.astro";
import { archiveData } from "../config";
import TimeLineItem from "@/components/archive/timeLineItem.astro";


---

<Layout title="Archive">
  <div class="archive-shell w-full h-full overflow-hidden rounded-2xl bg-white p-3 dark:bg-dark sm:p-10">
    <Row title="Archive" id="archive" href="#archive">
      <div class="relative flex h-fit w-full flex-col gap-6 overflow-hidden">
        <div class="flex w-fit items-center gap-3 rounded-full border border-theme-100 bg-theme-50 px-3 py-1.5 text-sm font-semibold text-theme-600 shadow-sm dark:border-theme-400/30 dark:bg-theme-400/10 dark:text-theme-100">
          <div class="size-3 rounded-full bg-theme-400 dark:bg-theme-300"></div>
          <span>My Journey</span>
        </div>

        <div class="flex flex-col gap-6">
          {archiveData.map((item, index) => (
            <div class="timeline-item-wrapper" style={`--timeline-delay:${index * 120}ms`}>
              <TimeLineItem {...item} timelineDelay={`${index * 120}ms`} />
            </div>
          ))}
        </div>
      </div>
    </Row>
  </div>
</Layout>

<style>
  .archive-shell {
    animation: archiveFadeIn 650ms ease-out both;
  }

  @keyframes archiveFadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
